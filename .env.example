# Optional: Cloudflare Worker URL for anonymous presence analytics (no document content).
# See presence-api/README.md for deploy steps.
# VITE_PRESENCE_API_URL=https://latex-to-word-presence.your-account.workers.dev

# Optional: Supabase Auth (register / sign-in). Must use VITE_ prefix.
# Use anon public or publishable (sb_publishable_…) key only — never service_role / sb_secret_.
# See docs/saas/AUTH.md for dashboard URL config and redirect URLs.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
